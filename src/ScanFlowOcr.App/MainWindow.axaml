<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:ScanFlowOcr.App.Models"
        x:Class="ScanFlowOcr.App.MainWindow"
        Title="ScanFlow-OCR"
        Width="1280" Height="840"
        MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        KeyDown="OnWindowKeyDown"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
  <Grid RowDefinitions="42,Auto,*,28">

    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0,10,0">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="22" Height="22" CornerRadius="4" Background="{DynamicResource BrandBrush}">
            <TextBlock Text="SF" FontSize="10" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="ScanFlow-OCR" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Border Classes="chip" VerticalAlignment="Center">
            <TextBlock Text="桌面 OCR 工作台" Classes="muted" />
          </Border>
        </StackPanel>
        <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="chip" Padding="10,3">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse x:Name="DotHeaderStatus" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" />
            <TextBlock Text="会话:" Classes="muted" VerticalAlignment="Center" />
            <TextBlock x:Name="TxtHeaderSession" Text="服务已就绪" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="SettingsButton" Classes="outline" Height="28" Content="设置" Click="OnOpenSettings" />
          <Button x:Name="ThemeToggleButton" Classes="ghost" Width="32" Height="28" Padding="0"
                  ToolTip.Tip="切换浅色 / 深色主题" Click="OnToggleTheme">
            <TextBlock x:Name="ThemeToggleGlyph" Text="☀" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Toolbar -->
    <Border Grid.Row="1" Classes="panel-card" Margin="12,8,12,0" Padding="10,7">
      <StackPanel Spacing="7">
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="PillScanStatus" Classes="chip" Padding="8,4" Margin="0,0,10,0" Height="32">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse x:Name="DotState" Width="7" Height="7" Fill="{DynamicResource TextMutedBrush}" />
              <TextBlock x:Name="TxtSessionState" Text="就绪" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Width="1" Height="20" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,10,0" />
          <TextBlock Text="输入源:" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0" />
          <ComboBox x:Name="CameraDeviceCombo" MinWidth="150" MaxWidth="220" Height="32" Margin="0,0,6,0"
                    SelectionChanged="OnCameraDeviceChanged" />
          <ComboBox x:Name="CameraModeCombo" MinWidth="140" MaxWidth="200" Height="32" Margin="0,0,6,0" />
          <Button x:Name="RefreshCamerasButton" Classes="outline" Height="32" Margin="0,0,8,0" Content="刷新" Click="OnRefreshCameras" />
          <Border Width="1" Height="20" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,8,0" />
          <Button Classes="outline" Height="32" Margin="0,0,6,0" Content="导入图片…" Click="OnOpenImages" />
          <Button Classes="outline" Height="32" Margin="0,0,6,0" Content="导入文件夹…" Click="OnOpenImageFolder" />
        </WrapPanel>
        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="OCR 模型:" Classes="muted" VerticalAlignment="Center" Margin="0,0,4,0" />
          <ComboBox x:Name="ModelCombo" Width="90" Height="32" SelectedIndex="0" Margin="0,0,8,0">
            <ComboBoxItem Content="tiny" />
            <ComboBoxItem Content="small" />
          </ComboBox>
          <Button x:Name="RunOcrButton" Classes="outline" Height="32" Margin="0,0,16,0" Content="识别图片" Click="OnRunOcr" IsEnabled="False" />
          <Button x:Name="StartScanButton" Classes="primary" Height="34" Margin="0,0,6,0" Content="启动扫描" Click="OnStartScan" />
          <Button x:Name="StopScanButton" Classes="outline" Height="34" Margin="0,0,6,0" Content="停止扫描" Click="OnStopScan" IsEnabled="False" />
          <Button x:Name="StartPreviewButton" Classes="outline" Height="34" Margin="0,0,6,0" Content="仅预览" Click="OnStartPreview" />
          <Button x:Name="StopPreviewButton" Classes="outline" Height="34" Margin="0,0,6,0" Content="停预览" Click="OnStopPreview" IsEnabled="False" />
          <Button x:Name="OcrFrameButton" Classes="outline" Height="34" Margin="0,0,6,0" Content="识别当前帧" Click="OnOcrCurrentFrame" IsEnabled="False" />
          <Button x:Name="ClearDedupeButton" Classes="ghost" Height="34" Content="重置去重" Click="OnClearDedupe" ToolTip.Tip="清空会话去重历史" />
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Workspace -->
    <Grid Grid.Row="2" Margin="12,8,12,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="13*" MinWidth="480" />
        <ColumnDefinition Width="6*" MinWidth="340" MaxWidth="580" />
      </Grid.ColumnDefinitions>

      <!-- Viewport -->
      <Border Grid.Column="0" Classes="panel-card" ClipToBounds="True" Margin="0,0,6,0">
        <Grid RowDefinitions="*,Auto,30">
          <Grid Grid.Row="0" x:Name="ViewportHost" Background="{DynamicResource ViewportBackgroundBrush}"
                PointerWheelChanged="OnViewportWheel" DoubleTapped="OnViewportDoubleTap">
            <Viewbox x:Name="PreviewViewbox" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid x:Name="PreviewScaleRoot" RenderTransformOrigin="0.5,0.5">
                <Image x:Name="PreviewImage" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <!-- Overlay and editor coordinates stay in source-image pixels. Viewbox only scales this surface. -->
                <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="False"
                        PointerPressed="OnRoiPointerPressed"
                        PointerMoved="OnRoiPointerMoved"
                        PointerReleased="OnRoiPointerReleased"
                        PointerCaptureLost="OnRoiPointerCaptureLost">
                  <Rectangle x:Name="RoiRect" Stroke="{DynamicResource BrandBrush}" StrokeThickness="2"
                             StrokeDashArray="4,2" Fill="#22007AFF" IsVisible="False" />
                  <Canvas x:Name="RoiEditorVisualCanvas" IsHitTestVisible="False" />
                  <!-- Crosshair -->
                  <Line x:Name="CrosshairH" Stroke="{DynamicResource ReticleAccentBrush}" StrokeThickness="1.2"
                        Opacity="0.85" IsVisible="True" />
                  <Line x:Name="CrosshairV" Stroke="{DynamicResource ReticleAccentBrush}" StrokeThickness="1.2"
                        Opacity="0.85" IsVisible="True" />
                </Canvas>
              </Grid>
            </Viewbox>

            <Panel x:Name="PanelPlaceholder" IsVisible="True">
              <Border Width="360" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center"
                      BorderBrush="{DynamicResource ReticleGridBrush}" BorderThickness="1" CornerRadius="4" Opacity="0.85">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4" Margin="16">
                  <TextBlock x:Name="TxtPlaceholderTitle" Text="未启动扫描" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
                  <TextBlock x:Name="TxtPlaceholderSub" Text="选择相机后【启动扫描】连续 OCR，或导入图片识别"
                             FontSize="11" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" />
                </StackPanel>
              </Border>
            </Panel>

            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                    Background="{DynamicResource ViewportOverlayBackgroundBrush}"
                    BorderBrush="{DynamicResource ViewportOverlayBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="10,4">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Ellipse x:Name="DotHudLive" Width="6" Height="6" Fill="{DynamicResource TextMutedBrush}" />
                <TextBlock x:Name="TxtHudTitle" Text="取景预览" FontSize="11" FontWeight="SemiBold"
                           FontFamily="Cascadia Code, Consolas, monospace" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtDedupeHud" Text="" FontSize="11" Classes="muted" VerticalAlignment="Center" />
              </StackPanel>
            </Border>

            <Border x:Name="LatestResultToast" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12,48,12,0"
                    Background="{DynamicResource ViewportOverlayBackgroundBrush}"
                    BorderBrush="{DynamicResource ViewportOverlayBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10,7" MaxWidth="360" IsVisible="False">
              <StackPanel Spacing="3">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="OCR 接纳" FontSize="10" Classes="muted" />
                  <TextBlock x:Name="TxtLatestResultMeta" Text="" FontSize="10" Classes="muted" />
                </StackPanel>
                <TextBlock x:Name="TxtLatestResult" Text="" FontSize="12" FontWeight="SemiBold"
                           TextWrapping="Wrap" MaxWidth="330" />
              </StackPanel>
            </Border>

            <Border x:Name="RoiEditorBar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,0,12,12"
                    Background="{DynamicResource ViewportOverlayBackgroundBrush}"
                    BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1"
                    CornerRadius="7" Padding="10,7" IsVisible="False">
              <StackPanel Spacing="5">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="编辑识别区域" FontSize="12" FontWeight="SemiBold" />
                  <TextBlock Text="拖动空白处框选 · 拖动区域移动 · 四角调整" FontSize="10" Classes="muted"
                             VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="TxtRoiDraftCoordinates" FontSize="11" FontFamily="Cascadia Code, Consolas, monospace" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                  <Button Classes="ghost" Height="26" Content="全画面" Click="OnFullRoi" />
                  <Button Classes="ghost" Height="26" Content="取消" Click="OnCancelRoi" />
                  <Button x:Name="BtnRoiSave" Classes="primary" Height="26" Content="保存 ROI" Click="OnSaveRoi" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12"
                    Background="{DynamicResource ViewportOverlayBackgroundBrush}"
                    BorderBrush="{DynamicResource ViewportOverlayBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="4">
              <Button x:Name="BtnEditRoi" Classes="ghost" Height="24" Content="编辑 ROI"
                      Click="OnBeginRoiEdit" ToolTip.Tip="在当前画面中拖拽框选 OCR 识别区域" />
            </Border>

            <!-- Zoom pill -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12"
                    Background="{DynamicResource ViewportOverlayBackgroundBrush}"
                    BorderBrush="{DynamicResource ViewportOverlayBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="4">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="ghost" Width="28" Height="24" Content="−" Click="OnZoomOut" ToolTip.Tip="缩小" />
                <Button Classes="ghost" Height="24" Padding="6,0" Click="OnZoomReset">
                  <TextBlock x:Name="TxtZoomLevel" Text="100%" FontSize="11" FontFamily="Cascadia Code, Consolas, monospace" />
                </Button>
                <Button Classes="ghost" Width="28" Height="24" Content="+" Click="OnZoomIn" ToolTip.Tip="放大" />
                <Button x:Name="BtnToggleGuides" Classes="ghost" Width="28" Height="24" Content="✚"
                        Click="OnToggleGuides" ToolTip.Tip="准星开关" />
              </StackPanel>
            </Border>

            <TextBlock x:Name="CameraErrorText" Margin="12,40,12,12" HorizontalAlignment="Left" VerticalAlignment="Top"
                       TextWrapping="Wrap" MaxWidth="420" Foreground="{DynamicResource DangerBrush}" IsVisible="False" />
          </Grid>

          <!-- Playlist -->
          <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtleBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="28,*">
              <Border Grid.Row="0" Padding="10,0">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="图像列表" FontSize="11" FontWeight="SemiBold" />
                  <Border Classes="chip">
                    <TextBlock x:Name="TxtImageCount" Text="0 张" FontSize="11" FontFamily="Cascadia Code, Consolas, monospace" />
                  </Border>
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" MaxHeight="116">
                <ItemsControl x:Name="PlaylistItems" Margin="8,0,8,8">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:PlaylistThumbnailItem">
                      <StackPanel Width="88" Spacing="3">
                      <Border Classes="playlist-card" Classes.active="{Binding IsActive}" Width="88" Height="72" CornerRadius="4" ClipToBounds="True"
                              BorderThickness="2"
                              BorderBrush="{DynamicResource BorderSubtleBrush}"
                              Background="{DynamicResource SurfaceBackgroundBrush}"
                              PointerPressed="OnPlaylistItemPressed"
                              Tag="{Binding}">
                        <Grid>
                          <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                          <Border Background="#88000000" VerticalAlignment="Bottom" Padding="4,2">
                            <TextBlock Text="{Binding IndexDisplay}" FontSize="10" Foreground="White" />
                          </Border>
                        </Grid>
                      </Border>
                      <TextBlock Text="{Binding FileName}" FontSize="10" Classes="muted" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Row="2" Background="{DynamicResource SurfaceBackgroundBrush}"
                  BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="12,0">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="chip">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="取景: " Classes="muted" />
                    <TextBlock x:Name="TxtPreviewMetrics" Text="未启用" FontSize="11" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
                <Border Classes="chip">
                  <StackPanel Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="状态: " Classes="muted" />
                    <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
                <Border Classes="chip">
                  <TextBlock x:Name="TxtSessionMetrics" Text="帧 0 / 丢 0" FontSize="11"
                             FontFamily="Cascadia Code, Consolas, monospace" Classes="muted" />
                </Border>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="FlashCap · PP-OCRv6" FontSize="11"
                         FontFamily="Cascadia Code, Consolas, monospace" Classes="muted" />
            </Grid>
          </Border>
        </Grid>
      </Border>

      <!-- Results -->
      <Border Grid.Column="1" Classes="panel-card" Padding="12">
        <Grid RowDefinitions="Auto,Auto,*,Auto,120">
          <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="识别结果" Classes="section-title" />
              <Border Classes="chip">
                <TextBlock x:Name="TxtResultCount" Text="0 行" FontSize="11" FontWeight="SemiBold"
                           FontFamily="Cascadia Code, Consolas, monospace" />
              </Border>
            </StackPanel>
            <Button Grid.Column="1" Classes="outline" Height="28" Content="清空" Click="OnClearResults" />
          </Grid>

          <TextBox x:Name="ResultSearchBox" Grid.Row="1" PlaceholderText="搜索结果…" Height="30" Margin="0,0,0,8"
                   TextChanged="OnResultSearchChanged" />

          <Grid Grid.Row="2" RowDefinitions="*,110" RowSpacing="8">
            <ListBox x:Name="ResultsList" SelectionChanged="OnResultSelectionChanged"
                     Background="{DynamicResource SurfaceSubtleBackgroundBrush}"
                     BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:ScanResultItem">
                  <StackPanel Margin="4,2" Spacing="2">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Time}" Classes="muted" FontSize="10" />
                      <TextBlock Text="{Binding ConfidenceDisplay}" Classes="muted" FontSize="10" />
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="1" Background="{DynamicResource SurfaceSubtleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="OCR 详情" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Classes="outline" Height="24" Content="复制文本" Click="OnCopySelectedResult" />
                </Grid>
                <TextBlock x:Name="TxtInspectorText" Text="选择一条结果查看详情" TextWrapping="Wrap" FontSize="12" />
                <TextBlock x:Name="TxtInspectorMeta" Classes="muted" TextWrapping="Wrap" FontSize="11"
                           FontFamily="Cascadia Code, Consolas, monospace" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Grid.Row="3" Classes="panel-card" Padding="10" Margin="0,8,0,8"
                  Background="{DynamicResource SurfaceSubtleBackgroundBrush}">
            <StackPanel Spacing="6">
              <TextBlock Text="输出（快捷）" FontSize="12" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <RadioButton x:Name="SinkNone" Content="关" GroupName="Sink" IsChecked="True" />
                <RadioButton x:Name="SinkKeyboard" Content="键盘" GroupName="Sink" />
                <RadioButton x:Name="SinkMqtt" Content="MQTT" GroupName="Sink" />
                <RadioButton x:Name="SinkTcp" Content="TCP" GroupName="Sink" />
                <Button Classes="outline" Height="26" Content="应用" Click="OnApplyOutput" />
                <Button x:Name="SendOutputButton" Classes="primary" Height="26" Content="发送" Click="OnSendOutput" IsEnabled="False" />
              </StackPanel>
              <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="4">
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="目标" />
                <TextBox x:Name="KeyboardTarget" Grid.Column="1" Text="notepad.exe" Height="26" />
                <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center" Text="MQTT" />
                <TextBox x:Name="MqttBroker" Grid.Column="3" Text="localhost" Height="26" />
                <TextBlock Grid.Row="1" Classes="muted" VerticalAlignment="Center" Text="主题" />
                <TextBox x:Name="MqttTopic" Grid.Row="1" Grid.Column="1" Text="scanflow-ocr/scans" Height="26" />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" VerticalAlignment="Center" Text="TCP" />
                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="4">
                  <TextBox x:Name="TcpHost" Width="90" Text="127.0.0.1" Height="26" />
                  <TextBox x:Name="TcpPort" Width="60" Text="9100" Height="26" />
                  <TextBox x:Name="MqttPort" Width="50" Text="1883" Height="26" IsVisible="False" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <DockPanel Grid.Row="4">
            <TextBlock DockPanel.Dock="Top" Text="运行日志" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
            <Border Background="{DynamicResource SurfaceSubtleBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="2">
              <TextBox x:Name="Log" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"
                       FontFamily="Cascadia Code, Consolas, monospace" FontSize="11"
                       BorderThickness="0" Background="Transparent" />
            </Border>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Background="{DynamicResource SurfaceBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="14,0">
      <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
        <TextBlock x:Name="TxtFooterHint" Text="ScanFlow-OCR · PP-OCRv6 · 跨平台 OCR 工作台" Classes="muted" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0">
          <TextBlock x:Name="TxtOutputQueueStatus" Text="输出未启用" Classes="muted" VerticalAlignment="Center" />
          <Button x:Name="BtnClearOutputQueue" Classes="ghost" Height="24" Content="清空队列"
                  Click="OnClearOutputQueue" IsEnabled="False" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="Avalonia 12.1.2" Classes="muted" />
      </Grid>
    </Border>
  </Grid>
</Window>
