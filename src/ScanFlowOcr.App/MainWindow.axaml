<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ScanFlowOcr.App.MainWindow"
        Title="ScanFlow-OCR"
        Width="960" Height="640">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <Button Content="Enumerate cameras" Click="OnEnumerateCameras"/>
      <Button Content="OCR (placeholder)" Click="OnOcrPlaceholder"/>
      <Button Content="Keyboard sink info" Click="OnKeyboardInfo"/>
    </StackPanel>
    <TextBox x:Name="Log" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap"
             FontFamily="Consolas, monospace"/>
  </DockPanel>
</Window>
