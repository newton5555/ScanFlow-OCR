<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Neutral Dark Charcoal Color Palette (Aligned with Prototype) -->
  <Color x:Key="AppBackgroundColor">#111315</Color>
  <Color x:Key="SurfaceBackgroundColor">#171a1d</Color>
  <Color x:Key="SurfaceSubtleBackgroundColor">#1f2327</Color>
  <Color x:Key="SurfaceHoverBackgroundColor">#262b30</Color>
  <Color x:Key="SurfaceCardColor">#171a1d</Color>
  <Color x:Key="SurfaceInputColor">#111315</Color>
  <Color x:Key="ViewportBackgroundColor">#0c0e10</Color>

  <Color x:Key="BorderSubtleColor">#292f36</Color>
  <Color x:Key="BorderMediumColor">#3b434d</Color>
  <Color x:Key="BorderFocusColor">#5279a4</Color>

  <Color x:Key="TextPrimaryColor">#e6edf3</Color>
  <Color x:Key="TextSecondaryColor">#9aa2ae</Color>
  <Color x:Key="TextMutedColor">#818b98</Color>
  <Color x:Key="TextInverseColor">#111315</Color>

  <Color x:Key="BrandColor">#3b719f</Color>
  <Color x:Key="BrandHoverColor">#4a84b5</Color>
  <Color x:Key="BrandSoftColor">#1a2733</Color>
  <Color x:Key="BrandBorderColor">#29445f</Color>

  <Color x:Key="SuccessColor">#10b981</Color>
  <Color x:Key="WarningColor">#f59e0b</Color>
  <Color x:Key="DangerColor">#ef4444</Color>
  <Color x:Key="DuplicateColor">#818cf8</Color>

  <!-- SolidColorBrushes -->
  <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceSubtleBackgroundBrush" Color="{StaticResource SurfaceSubtleBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBackgroundBrush" Color="{StaticResource SurfaceHoverBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}" />
  <SolidColorBrush x:Key="SurfaceInputBrush" Color="{StaticResource SurfaceInputColor}" />
  <SolidColorBrush x:Key="ViewportBackgroundBrush" Color="{StaticResource ViewportBackgroundColor}" />

  <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
  <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMediumColor}" />
  <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TextInverseBrush" Color="{StaticResource TextInverseColor}" />

  <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandColor}" />
  <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandHoverColor}" />
  <SolidColorBrush x:Key="BrandSoftBrush" Color="{StaticResource BrandSoftColor}" />
  <SolidColorBrush x:Key="BrandBorderBrush" Color="{StaticResource BrandBorderColor}" />

  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DuplicateBrush" Color="{StaticResource DuplicateColor}" />

  <!-- Soft Semantic Brushes (Matched to Prototype) -->
  <SolidColorBrush x:Key="SuccessBgBrush" Color="#1f10b981" />
  <SolidColorBrush x:Key="SuccessTextBrush" Color="#34d399" />
  <SolidColorBrush x:Key="SuccessBorderBrush" Color="#4710b981" />

  <SolidColorBrush x:Key="DuplicateBgBrush" Color="#1f818cf8" />
  <SolidColorBrush x:Key="DuplicateTextBrush" Color="#a5b4fc" />
  <SolidColorBrush x:Key="DuplicateBorderBrush" Color="#47818cf8" />

  <SolidColorBrush x:Key="DangerBgBrush" Color="#1fef4444" />
  <SolidColorBrush x:Key="DangerTextBrush" Color="#f87171" />
  <SolidColorBrush x:Key="DangerBorderBrush" Color="#47ef4444" />

  <SolidColorBrush x:Key="WarningBgBrush" Color="#1ff59e0b" />
  <SolidColorBrush x:Key="WarningTextBrush" Color="#fbbf24" />
  <SolidColorBrush x:Key="WarningBorderBrush" Color="#47f59e0b" />

  <!-- Viewport Overlay & Reticle Brushes -->
  <SolidColorBrush x:Key="ViewportOverlayBackgroundBrush" Color="#e00c0e10" />
  <SolidColorBrush x:Key="ViewportOverlayBorderBrush" Color="#33ffffff" />
  <SolidColorBrush x:Key="ReticleGridBrush" Color="#28303a" />
  <SolidColorBrush x:Key="ReticleAccentBrush" Color="#3b719f" />

  <RadialGradientBrush x:Key="ReticleCenterGlowBrush" Center="50%,50%" GradientOrigin="50%,50%" RadiusX="50%" RadiusY="50%">
    <GradientStop Color="#251a5c9e" Offset="0" />
    <GradientStop Color="#000c0e10" Offset="1" />
  </RadialGradientBrush>

  <!-- OCR Badges -->
  <SolidColorBrush x:Key="SymbologyBadgeOcrBgBrush" Color="#162235" />
  <SolidColorBrush x:Key="SymbologyBadgeOcrTintBrush" Color="#162235" Opacity="0.55" />
  <SolidColorBrush x:Key="SymbologyBadgeOcrBorderBrush" Color="#1f385c" />
  <SolidColorBrush x:Key="SymbologyBadgeOcrTextBrush" Color="#60a5fa" />

  <!-- Reading-axis arrow: always red so it never collides with per-box accents -->
  <SolidColorBrush x:Key="ReadingAxisArrowBrush" Color="#ff4d4f" />

  <!-- Green ToggleSwitch Brushes (Matching Reference) -->
  <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#16a34a" />
  <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#22c55e" />
  <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#15803d" />
  <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#16a34a" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#ffffff" />
  <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#ffffff" />

</ResourceDictionary>
