<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- CornerRadius Design Tokens -->
  <CornerRadius x:Key="RadiusXs">3</CornerRadius>
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">6</CornerRadius>
  <CornerRadius x:Key="RadiusLg">8</CornerRadius>
  <CornerRadius x:Key="RadiusPill">13</CornerRadius>

  <!-- Dimension Design Tokens -->
  <x:Double x:Key="HeaderHeight">42</x:Double>
  <x:Double x:Key="FooterHeight">28</x:Double>

  <!-- Typography Scale Design Tokens -->
  <x:Double x:Key="FontSizeXs">11</x:Double>
  <x:Double x:Key="FontSizeSm">12</x:Double>
  <x:Double x:Key="FontSizeBase">13</x:Double>
  <x:Double x:Key="FontSizeLg">14</x:Double>
  <x:Double x:Key="FontSizeTitle">16</x:Double>

</ResourceDictionary>
