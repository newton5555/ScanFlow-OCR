<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <ProjectReference Include="../ScanFlowOcr.Contracts/ScanFlowOcr.Contracts.csproj" />
    <ProjectReference Include="../ScanFlowOcr.Imaging/ScanFlowOcr.Imaging.csproj" />
    <ProjectReference Include="../ScanFlowOcr.Capture.FlashCap/ScanFlowOcr.Capture.FlashCap.csproj" />
    <ProjectReference Include="../ScanFlowOcr.Ocr.SimdPaddle/ScanFlowOcr.Ocr.SimdPaddle.csproj" />
    <ProjectReference Include="../ScanFlowOcr.Outputs/ScanFlowOcr.Outputs.csproj" />
    <ProjectReference Include="../ScanFlowOcr.Runtime/ScanFlowOcr.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\native\win-x64\turbojpeg.dll" Link="native\win-x64\turbojpeg.dll" Condition="Exists('..\..\native\win-x64\turbojpeg.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Include="..\..\native\linux-x64\libturbojpeg.so" Link="native\linux-x64\libturbojpeg.so" Condition="Exists('..\..\native\linux-x64\libturbojpeg.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
